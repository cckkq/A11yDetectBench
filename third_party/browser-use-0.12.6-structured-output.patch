+def _dump_structured_output_parse_failure(
+	raw_text: str,
+	*,
+	provider: str,
+	model: str,
+	output_format_name: str,
+	error: Exception,
+	stop_reason: str | None,
+	response_id: str | None,
+) -> None:
+	debug_dir = os.getenv('BROWSER_USE_STRUCTURED_DEBUG_DIR')
+	if not debug_dir:
+		return
+
+	try:
+		root = Path(debug_dir)
+		root.mkdir(parents=True, exist_ok=True)
+		payload = {
+			'timestamp': datetime.now(timezone.utc).isoformat(),
+			'provider': provider,
+			'model': model,
+			'output_format': output_format_name,
+			'stop_reason': stop_reason,
+			'response_id': response_id,
+			'error_type': type(error).__name__,
+			'error_message': str(error),
+			'raw_text': raw_text,
+		}
+		path = root / f'structured_parse_failure_{datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S_%f")}_{uuid4().hex[:8]}.json'
+		with path.open('w', encoding='utf-8') as handle:
+			json.dump(payload, handle, ensure_ascii=False, indent=2)
+			handle.write('\n')
+	except Exception:
+		# Debug capture must never mask the original provider/parsing error.
+		return
+
+
+def _extract_first_json_block(text: str) -> str | None:
+	"""Scan text for the first top-level balanced {...} JSON object.
+
+	Returns the substring, or None if no complete object found. Used by the
+	multi-JSON salvage path to recover when the model emits multiple
+	concatenated JSON objects in a single completion.
+	"""
+	in_string = False
+	escape = False
+	depth = 0
+	start = -1
+	for i, ch in enumerate(text):
+		if start == -1:
+			if ch == '{':
+				start = i
+				depth = 1
+				in_string = False
+				escape = False
+			continue
+		if in_string:
+			if escape:
+				escape = False
+			elif ch == '\\':
+				escape = True
+			elif ch == '"':
+				in_string = False
+		else:
+			if ch == '"':
+				in_string = True
+			elif ch == '{':
+				depth += 1
+			elif ch == '}':
+				depth -= 1
+				if depth == 0:
+					return text[start:i + 1]
+	return None
+
+
+def _dump_structured_output_salvage(
+	raw_text: str,
+	salvaged_block: str,
+	*,
+	provider: str,
+	model: str,
+	output_format_name: str,
+	response_id: str | None,
+) -> None:
+	"""Record a multi-JSON salvage event. Uses the same
+	BROWSER_USE_STRUCTURED_DEBUG_DIR env var but writes into a
+	`structured_parse_salvaged/` subdir so it does not mix with genuine
+	parse failures."""
+	debug_dir = os.getenv('BROWSER_USE_STRUCTURED_DEBUG_DIR')
+	if not debug_dir:
+		return
+	try:
+		root = Path(debug_dir) / 'structured_parse_salvaged'
+		root.mkdir(parents=True, exist_ok=True)
+		# Recover every additional top-level block for archival only.
+		remaining = raw_text[len(salvaged_block):].lstrip()
+		dropped_blocks: list[str] = []
+		while remaining:
+			nxt = _extract_first_json_block(remaining)
+			if nxt is None:
+				break
+			dropped_blocks.append(nxt)
+			remaining = remaining[len(nxt):].lstrip()
+		payload = {
+			'timestamp': datetime.now(timezone.utc).isoformat(),
+			'provider': provider,
+			'model': model,
+			'output_format': output_format_name,
+			'response_id': response_id,
+			'raw_text': raw_text,
+			'salvaged_block': salvaged_block,
+			'total_blocks': 1 + len(dropped_blocks),
+			'dropped_blocks_count': len(dropped_blocks),
+			'dropped_blocks': dropped_blocks,
+		}
+		path = root / f'salvage_{datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S_%f")}_{uuid4().hex[:8]}.json'
+		with path.open('w', encoding='utf-8') as handle:
+			json.dump(payload, handle, ensure_ascii=False, indent=2)
+			handle.write('\n')
+	except Exception:
+		return
+
